<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DemoFile.Game.Cs" Version="0.44.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\geometry\de_mirage.mesh" Condition="Exists('..\..\data\geometry\de_mirage.mesh')">
      <Link>Geometry\de_mirage.mesh</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Features\Situation\Analysis\Rules\*.json">
      <LogicalName>CsDemoMap.Api.SituationRules.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Features\Situation\Training\situation-training-selection-v1.json">
      <LogicalName>CsDemoMap.Api.SituationTraining.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Features\Situation\Training\situation-prompt-representation-v1.json">
      <LogicalName>CsDemoMap.Api.SituationTraining.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Features\Situation\Training\situation-review-selection-v1.json">
      <LogicalName>CsDemoMap.Api.SituationReview.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
