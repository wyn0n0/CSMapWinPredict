{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-demo-map.local/schemas/situation/situation-analysis-v1.schema.json",
  "title": "SituationAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "narrativeSource": { "const": "template" } }, "required": ["narrativeSource"] },
      "then": { "properties": { "model": { "type": "null" } } }
    },
    {
      "if": { "properties": { "narrativeSource": { "const": "lora" } }, "required": ["narrativeSource"] },
      "then": { "properties": { "model": { "type": "object" } } }
    }
  ],
  "required": ["schemaVersion", "requestedTick", "tick", "generatedAt", "versions", "model", "narrativeSource", "facts", "narrative"],
  "properties": {
    "schemaVersion": { "const": "situation-analysis-v1" },
    "requestedTick": { "type": "integer", "minimum": 0 },
    "tick": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "builder", "geometry", "facts", "rules", "narrative"],
      "properties": {
        "scene": { "const": "minimap-scene-v1" },
        "builder": { "const": "situation-scene-builder-v1.3" },
        "geometry": { "const": "mirage-geometry-v1" },
        "facts": { "const": "situation-facts-v1" },
        "rules": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$" },
        "narrative": { "const": "situation-narrative-v1" }
      }
    },
    "model": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseRevision", "adapterSha256"],
          "properties": {
            "baseRevision": { "type": "string", "minLength": 1 },
            "adapterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "narrativeSource": { "enum": ["template", "lora"] },
    "facts": { "$ref": "situation-facts-v1.schema.json" },
    "narrative": { "$ref": "situation-narrative-v1.schema.json" }
  }
}
