{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-demo-map.local/schemas/situation/situation-frozen-review-manifest-v1.schema.json",
  "title": "SituationFrozenReviewManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "reviewVersion", "datasetSha256", "reviewCandidateSha256", "schemaFiles", "counts", "files"],
  "properties": {
    "schemaVersion": { "const": "situation-frozen-review-manifest-v1" },
    "status": { "enum": ["incomplete", "complete"] },
    "reviewVersion": { "type": "string", "minLength": 1 },
    "datasetSha256": { "$ref": "#/$defs/sha256" },
    "reviewCandidateSha256": { "$ref": "#/$defs/sha256" },
    "schemaFiles": { "type": "array", "minItems": 1, "items": { "$ref": "situation-training-manifest-v1.schema.json#/$defs/schemaFile" } },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "dev", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 0 },
        "dev": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "files": { "type": "array", "items": { "$ref": "situation-training-manifest-v1.schema.json#/$defs/file" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
