{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-demo-map.local/schemas/situation/situation-review-candidate-v1.schema.json",
  "title": "SituationReviewCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewOrdinal", "sampleId", "split", "matchRef", "roundRef", "selectionTags", "input", "candidate", "recordSha256", "candidateSha256"],
  "properties": {
    "schemaVersion": { "const": "situation-review-candidate-v1" },
    "reviewOrdinal": { "type": "integer", "minimum": 1 },
    "sampleId": { "type": "string", "pattern": "^sample-[0-9a-f]{64}$" },
    "split": { "enum": ["train", "dev", "test"] },
    "matchRef": { "type": "string", "pattern": "^match-[0-9a-f]{64}$" },
    "roundRef": { "type": "string", "pattern": "^round-[0-9a-f]{64}$" },
    "selectionTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "input": { "$ref": "situation-training-record-v1.schema.json#/$defs/trainingInput" },
    "candidate": { "$ref": "situation-narrative-v1.schema.json" },
    "recordSha256": { "$ref": "#/$defs/sha256" },
    "candidateSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
