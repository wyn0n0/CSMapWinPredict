{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-demo-map.local/schemas/situation/situation-review-candidate-provenance-v1.schema.json",
  "title": "SituationReviewCandidateProvenanceV1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "baseManifestSha256", "baseProvenanceSha256", "splitSha256", "policySha256", "policyVersion", "gitHead", "gitDirty", "historicalValidation", "baseFiles", "consumerFiles"],
  "properties": {
    "schemaVersion": {"const": "situation-review-candidate-provenance-v1"},
    "policyVersion": {"const": "situation-review-selection-v1"},
    "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitDirty": {"type": "boolean"},
    "baseManifestSha256": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/sha"},
    "baseProvenanceSha256": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/sha"},
    "splitSha256": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/sha"},
    "policySha256": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/sha"},
    "historicalValidation": {"type": "string", "minLength": 1},
    "baseFiles": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/file"}},
    "consumerFiles": {"type": "array", "minItems": 1, "items": {"$ref": "situation-review-artifact-common-v1.schema.json#/$defs/sourceFile"}}
  }
}
