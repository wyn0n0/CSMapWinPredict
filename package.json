{
  "name": "cs-demo-map",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "test:situation:stage4:freeze": "node tools/run-tests.mjs situation:stage4:freeze",
    "test:situation:raycast": "node tools/run-tests.mjs situation:raycast",
    "test:situation:stage4:review": "node tools/run-tests.mjs situation:stage4:review",
    "dev": "concurrently -n api,web -c blue,green \"dotnet run --project apps/api/CsDemoMap.Api.csproj --no-restore\" \"npm run dev --workspace @cs-demo-map/web\"",
    "dev:web": "npm run dev --workspace @cs-demo-map/web",
    "dev:api": "dotnet run --project apps/api/CsDemoMap.Api.csproj --no-restore",
    "build": "npm run build --workspace @cs-demo-map/web",
    "test": "node tools/run-tests.mjs",
    "test:web": "npm run test --workspace @cs-demo-map/web",
    "build:test:dotnet": "dotnet build tests/CsDemoMap.Api.Tests/CsDemoMap.Api.Tests.csproj -c Release --artifacts-path .artifacts/dotnet --ignore-failed-sources -p:NuGetAudit=false",
    "test:api": "node tools/run-tests.mjs api",
    "test:semantics": "node tools/run-tests.mjs semantics",
    "test:situation:stage3": "node tools/run-tests.mjs situation:stage3",
    "test:situation:stage4:split": "node tools/run-tests.mjs situation:stage4:split",
    "test:situation:stage4:contracts": "node tools/run-tests.mjs situation:stage4:contracts",
    "test:situation:stage4:eligibility": "node tools/run-tests.mjs situation:stage4:eligibility",
    "test:situation:stage4:selection": "node tools/run-tests.mjs situation:stage4:selection",
    "test:situation:stage4:pilot": "node tools/run-tests.mjs situation:stage4:pilot",
    "test:situation:stage4:review-candidates": "node tools/run-tests.mjs situation:stage4:review-candidates",
    "test:situation:stage6:index": "node tools/run-tests.mjs situation:stage6:index",
    "test:situation:stage6:writer": "node tools/run-tests.mjs situation:stage6:writer",
    "test:situation:stage6:validator": "node tools/run-tests.mjs situation:stage6:validator",
    "test:situation:stage6:integration": "node tools/run-tests.mjs situation:stage6:integration",
    "test:situation:stage6": "node tools/run-tests.mjs situation:stage6",
    "test:audit": "python -m unittest tools.test_audit_win_v4",
    "test:train": "python -m unittest tools.test_train_win_baseline",
    "test:train:v4": "python -m unittest tools.test_train_win_baseline_v4",
    "test:inference": "python -m unittest tools.test_win_inference_service",
    "test:inference:dotnet": "node tools/run-tests.mjs inference:dotnet",
    "cli": "dotnet run --project apps/cli/CsDemoMap.Cli.csproj --artifacts-path .artifacts/dotnet --",
    "typecheck": "npm run typecheck --workspace @cs-demo-map/web",
    "test:groups": "node tools/run-tests.mjs",
    "test:situation:export:index": "node tools/run-tests.mjs situation:export:index",
    "test:situation:export:writer": "node tools/run-tests.mjs situation:export:writer",
    "test:situation:export:validator": "node tools/run-tests.mjs situation:export:validator",
    "test:situation:export:integration": "node tools/run-tests.mjs situation:export:integration",
    "test:situation:export": "node tools/run-tests.mjs situation:export",
    "test:commands": "node --test tests/commands/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
